<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="https://qianji.dev">
  <process id="Process_1" isExecutable="true">
    <startEvent id="Start_1"/>
    <serviceTask id="Task_Draft" name="Draft proposal" implementation="${environment.services.runAgent}">
  <documentation>Draft a concise proposal from the user's initial idea. Output proposal.</documentation>
  <ioSpecification>
    <dataInput id="Task_Draft_input_idea" name="idea" />
    <dataOutput id="Task_Draft_output_proposal" name="proposal" />
    <inputSet id="Task_Draft_input_set">
    <dataInputRefs>Task_Draft_input_idea</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Draft_output_set">
    <dataOutputRefs>Task_Draft_output_proposal</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>idea</sourceRef>
    <targetRef>Task_Draft_input_idea</targetRef>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Draft_output_proposal</sourceRef>
    <targetRef>proposal</targetRef>
  </dataOutputAssociation>
</serviceTask>
    <userTask id="Task_Approve" name="Approve proposal">
  <documentation>How should the workflow proceed?</documentation>
  <ioSpecification>
    <dataInput id="Task_Approve_input_proposal" name="proposal" />
    <dataInput id="Task_Approve_input_interactionType" name="interactionType" />
    <dataInput id="Task_Approve_input_choices" name="choices" />
    <dataOutput id="Task_Approve_output_answer" name="answer" />
    <inputSet id="Task_Approve_input_set">
    <dataInputRefs>Task_Approve_input_proposal</dataInputRefs>
    <dataInputRefs>Task_Approve_input_interactionType</dataInputRefs>
    <dataInputRefs>Task_Approve_input_choices</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Approve_output_set">
    <dataOutputRefs>Task_Approve_output_answer</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>proposal</sourceRef>
    <targetRef>Task_Approve_input_proposal</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>choice_input</from><to>Task_Approve_input_interactionType</to></assignment>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>[{"value":"approved","label":"Approve","description":"Continue to the next BPMN checkpoint."},{"value":"rejected","label":"Reject","description":"Stop and revise before continuing."}]</from><to>Task_Approve_input_choices</to></assignment>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Approve_output_answer</sourceRef>
    <targetRef>approved</targetRef>
  </dataOutputAssociation>
</userTask>
    <exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_Rejected"/>
    <serviceTask id="Task_Finalize" name="Finalize proposal" implementation="${environment.services.runAgent}">
  <documentation>Finalize the approved proposal and output finalSummary.</documentation>
  <ioSpecification>
    <dataInput id="Task_Finalize_input_proposal" name="proposal" />
    <dataInput id="Task_Finalize_input_approved" name="approved" />
    <dataOutput id="Task_Finalize_output_finalSummary" name="finalSummary" />
    <inputSet id="Task_Finalize_input_set">
    <dataInputRefs>Task_Finalize_input_proposal</dataInputRefs>
    <dataInputRefs>Task_Finalize_input_approved</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Finalize_output_set">
    <dataOutputRefs>Task_Finalize_output_finalSummary</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>proposal</sourceRef>
    <targetRef>Task_Finalize_input_proposal</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>approved</sourceRef>
    <targetRef>Task_Finalize_input_approved</targetRef>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Finalize_output_finalSummary</sourceRef>
    <targetRef>finalSummary</targetRef>
  </dataOutputAssociation>
</serviceTask>
    <serviceTask id="Task_Revise" name="Record revision request" implementation="${environment.services.runAgent}">
  <documentation>Summarize why the proposal was not approved and output revisionRequest.</documentation>
  <ioSpecification>
    <dataInput id="Task_Revise_input_proposal" name="proposal" />
    <dataInput id="Task_Revise_input_approved" name="approved" />
    <dataOutput id="Task_Revise_output_revisionRequest" name="revisionRequest" />
    <inputSet id="Task_Revise_input_set">
    <dataInputRefs>Task_Revise_input_proposal</dataInputRefs>
    <dataInputRefs>Task_Revise_input_approved</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Revise_output_set">
    <dataOutputRefs>Task_Revise_output_revisionRequest</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>proposal</sourceRef>
    <targetRef>Task_Revise_input_proposal</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>approved</sourceRef>
    <targetRef>Task_Revise_input_approved</targetRef>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Revise_output_revisionRequest</sourceRef>
    <targetRef>revisionRequest</targetRef>
  </dataOutputAssociation>
</serviceTask>
    <endEvent id="End_Approved"/>
    <endEvent id="End_Rejected"/>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Draft"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_Draft" targetRef="Task_Approve"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_Approve" targetRef="Gateway_Approved"/>
    <sequenceFlow id="Flow_Approved" sourceRef="Gateway_Approved" targetRef="Task_Finalize">
      <conditionExpression>approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Rejected" sourceRef="Gateway_Approved" targetRef="Task_Revise"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_Finalize" targetRef="End_Approved"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_Revise" targetRef="End_Rejected"/>
  </process>
</definitions>
