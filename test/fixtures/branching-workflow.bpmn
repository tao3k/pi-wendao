<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="https://qianji.dev">
  <process id="Process_1" name="Branching Workflow" isExecutable="true">
    <startEvent id="Start_1"/>
    <serviceTask id="Task_RunTests" name="Run tests" implementation="${environment.services.runAgent}">
  <documentation>Run the test suite and determine if tests pass or fail.</documentation>
  <ioSpecification>
    <dataOutput id="Task_RunTests_output_testsPassed" name="testsPassed" />
    <inputSet id="Task_RunTests_input_set"></inputSet>
    <outputSet id="Task_RunTests_output_set">
    <dataOutputRefs>Task_RunTests_output_testsPassed</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataOutputAssociation>
    <sourceRef>Task_RunTests_output_testsPassed</sourceRef>
    <targetRef>testsPassed</targetRef>
  </dataOutputAssociation>
</serviceTask>
    <exclusiveGateway id="Gateway_1" name="Tests passed?" default="Flow_Fail"/>
    <serviceTask id="Task_ReportSuccess" name="Report success" implementation="${environment.services.runAgent}">
  <documentation>Report that all tests passed successfully.</documentation>
  <ioSpecification>
    <dataInput id="Task_ReportSuccess_input_testsPassed" name="testsPassed" />
    <inputSet id="Task_ReportSuccess_input_set">
    <dataInputRefs>Task_ReportSuccess_input_testsPassed</dataInputRefs>
  </inputSet>
    <outputSet id="Task_ReportSuccess_output_set"></outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>testsPassed</sourceRef>
    <targetRef>Task_ReportSuccess_input_testsPassed</targetRef>
  </dataInputAssociation>
</serviceTask>
    <serviceTask id="Task_FixTests" name="Fix tests" implementation="${environment.services.runAgent}">
  <documentation>Analyze and fix the failing tests.</documentation>
  <ioSpecification>
    <dataInput id="Task_FixTests_input_testsPassed" name="testsPassed" />
    <inputSet id="Task_FixTests_input_set">
    <dataInputRefs>Task_FixTests_input_testsPassed</dataInputRefs>
  </inputSet>
    <outputSet id="Task_FixTests_output_set"></outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>testsPassed</sourceRef>
    <targetRef>Task_FixTests_input_testsPassed</targetRef>
  </dataInputAssociation>
</serviceTask>
    <endEvent id="End_1"/>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_RunTests"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_RunTests" targetRef="Gateway_1"/>
    <sequenceFlow id="Flow_Pass" sourceRef="Gateway_1" targetRef="Task_ReportSuccess">
      <conditionExpression xsi:type="tFormalExpression">testsPassed</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Fail" sourceRef="Gateway_1" targetRef="Task_FixTests"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_ReportSuccess" targetRef="End_1"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_FixTests" targetRef="End_1"/>
  </process>
</definitions>
