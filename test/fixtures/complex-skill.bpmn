<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:qianji="https://qianji.dev/bpmn/extensions"
             id="Definitions_1"
             targetNamespace="https://qianji.dev">

  <process id="Process_ComplexPipeline" isExecutable="true">

    <!-- Start -->
    <startEvent id="StartEvent_1"/>
    <sequenceFlow id="Flow_Start_Init" sourceRef="StartEvent_1" targetRef="Task_Init"/>

    <!-- Step 1: Initialize -->
    <serviceTask id="Task_Init" name="Initialize system" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Initialize the system. Sleep for 5 seconds using bash (run: sleep 5). Then set retryCount to 1 and status to "not ready".</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs></qianji:inputs>
          <qianji:outputs>retryCount,status</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_Init_EvalRetry" sourceRef="Task_Init" targetRef="Task_EvalRetry"/>

    <!-- Step 2: Evaluate if retryCount >= 3 -->
    <serviceTask id="Task_EvalRetry" name="Evaluate retry count" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Check if retryCount is greater than or equal to 3. If it is, set retriesExhausted to true. Otherwise set retriesExhausted to false.</qianji:prompt>
          <qianji:tools></qianji:tools>
          <qianji:inputs>retryCount</qianji:inputs>
          <qianji:outputs>retriesExhausted</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_EvalRetry_GW" sourceRef="Task_EvalRetry" targetRef="Gateway_RetryCheck"/>

    <!-- Gateway: retries exhausted? -->
    <exclusiveGateway id="Gateway_RetryCheck" default="Flow_RetryNo"/>
    <sequenceFlow id="Flow_RetryYes" sourceRef="Gateway_RetryCheck" targetRef="Task_SetReady">
      <conditionExpression xsi:type="tFormalExpression">retriesExhausted</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_RetryNo" sourceRef="Gateway_RetryCheck" targetRef="Task_IncrementRetry"/>

    <!-- Increment retryCount and loop back -->
    <serviceTask id="Task_IncrementRetry" name="Increment retry count" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Increment retryCount by 1. The current value of retryCount is provided as input. Output the new retryCount value. Also sleep for 5 seconds using bash (run: sleep 5).</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs>retryCount</qianji:inputs>
          <qianji:outputs>retryCount</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_Increment_EvalRetry" sourceRef="Task_IncrementRetry" targetRef="Task_EvalRetry"/>

    <!-- Set status to ready -->
    <serviceTask id="Task_SetReady" name="Set status to ready" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Set status to "ready". Sleep for 5 seconds using bash (run: sleep 5).</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs></qianji:inputs>
          <qianji:outputs>status</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_SetReady_Fork" sourceRef="Task_SetReady" targetRef="Gateway_Fork"/>

    <!-- Step 3: Parallel fork -->
    <parallelGateway id="Gateway_Fork"/>
    <sequenceFlow id="Flow_Fork_A" sourceRef="Gateway_Fork" targetRef="Task_BranchA"/>
    <sequenceFlow id="Flow_Fork_B" sourceRef="Gateway_Fork" targetRef="Task_BranchB"/>

    <!-- Branch A -->
    <serviceTask id="Task_BranchA" name="Branch A" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Then set resultA to "alpha".</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs></qianji:inputs>
          <qianji:outputs>resultA</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_A_Join" sourceRef="Task_BranchA" targetRef="Gateway_Join"/>

    <!-- Branch B -->
    <serviceTask id="Task_BranchB" name="Branch B" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Then set resultB to "beta".</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs></qianji:inputs>
          <qianji:outputs>resultB</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_B_Join" sourceRef="Task_BranchB" targetRef="Gateway_Join"/>

    <!-- Step 4: Parallel join -->
    <parallelGateway id="Gateway_Join"/>
    <sequenceFlow id="Flow_Join_Merge" sourceRef="Gateway_Join" targetRef="Task_Merge"/>

    <!-- Merge results -->
    <serviceTask id="Task_Merge" name="Merge results" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Then concatenate resultA and resultB into a single string called merged. For example if resultA is "alpha" and resultB is "beta", merged should be "alphabeta".</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs>resultA,resultB</qianji:inputs>
          <qianji:outputs>merged</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_Merge_Validate" sourceRef="Task_Merge" targetRef="Task_Validate"/>

    <!-- Step 5: Validate -->
    <serviceTask id="Task_Validate" name="Validate merged result" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Validate the merged result. Set valid to true when validation passes; otherwise set valid to false.</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs>merged</qianji:inputs>
          <qianji:outputs>valid</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>

    <!-- Fallback task -->
    <serviceTask id="Task_Fallback" name="Validation fallback" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Set valid to false and reason to "validation failed".</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs></qianji:inputs>
          <qianji:outputs>valid,reason</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_Fallback_Reject" sourceRef="Task_Fallback" targetRef="Task_Reject"/>

    <!-- Normal flow from validate to gateway -->
    <sequenceFlow id="Flow_Validate_ValidGW" sourceRef="Task_Validate" targetRef="Gateway_ValidCheck"/>

    <!-- Step 6/7: Check valid -->
    <exclusiveGateway id="Gateway_ValidCheck" default="Flow_NotValid"/>
    <sequenceFlow id="Flow_Valid" sourceRef="Gateway_ValidCheck" targetRef="Task_Publish">
      <conditionExpression xsi:type="tFormalExpression">valid</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_NotValid" sourceRef="Gateway_ValidCheck" targetRef="Task_Fallback"/>

    <!-- Publish -->
    <serviceTask id="Task_Publish" name="Publish result" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Set published to true.</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs></qianji:inputs>
          <qianji:outputs>published</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_Publish_End" sourceRef="Task_Publish" targetRef="EndEvent_Published"/>

    <endEvent id="EndEvent_Published"/>

    <!-- Reject -->
    <serviceTask id="Task_Reject" name="Reject result" implementation="${environment.services.runAgent}">
      <extensionElements>
        <qianji:config>
          <qianji:prompt>Sleep for 5 seconds using bash (run: sleep 5). Set rejected to true.</qianji:prompt>
          <qianji:tools>bash</qianji:tools>
          <qianji:inputs>reason</qianji:inputs>
          <qianji:outputs>rejected</qianji:outputs>
        </qianji:config>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_Reject_End" sourceRef="Task_Reject" targetRef="EndEvent_Rejected"/>

    <endEvent id="EndEvent_Rejected"/>

  </process>
</definitions>
