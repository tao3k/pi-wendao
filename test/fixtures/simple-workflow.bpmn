<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="https://qianji.dev">
  <process id="Process_1" name="Simple Workflow" isExecutable="true">
    <startEvent id="Start_1" name="Start"/>
    <serviceTask id="Task_1" name="List files" implementation="${environment.services.runAgent}">
  <documentation>List all files in the current directory and store the result.</documentation>
  <ioSpecification>
    <dataOutput id="Task_1_output_fileList" name="fileList" />
    <inputSet id="Task_1_input_set"></inputSet>
    <outputSet id="Task_1_output_set">
    <dataOutputRefs>Task_1_output_fileList</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataOutputAssociation>
    <sourceRef>Task_1_output_fileList</sourceRef>
    <targetRef>fileList</targetRef>
  </dataOutputAssociation>
</serviceTask>
    <endEvent id="End_1" name="End"/>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="End_1"/>
  </process>
</definitions>
