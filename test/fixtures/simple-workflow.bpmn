<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:skillsc="http://skillsc.dev/bpmn/extensions"
             id="Definitions_1"
             targetNamespace="http://skillsc.dev">
  <process id="Process_1" name="Simple Workflow" isExecutable="true">
    <startEvent id="Start_1" name="Start"/>
    <serviceTask id="Task_1" name="List files" implementation="${environment.services.runAgent}">
      <extensionElements>
        <skillsc:config>
          <skillsc:prompt>List all files in the current directory and store the result.</skillsc:prompt>
          <skillsc:tools>bash,read</skillsc:tools>
          <skillsc:inputs></skillsc:inputs>
          <skillsc:outputs>fileList</skillsc:outputs>
        </skillsc:config>
      </extensionElements>
    </serviceTask>
    <endEvent id="End_1" name="End"/>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="End_1"/>
  </process>
</definitions>
