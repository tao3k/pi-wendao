<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_PiAskInteractions"
             targetNamespace="https://qianji.dev/examples/pi-ask-interactions">
  <process id="Process_PiAskInteractions" isExecutable="true">
    <startEvent id="Start"/>

    <userTask id="Task_Input" name="Free-form input">
  <documentation>Describe the next investigation step.</documentation>
  <ioSpecification>
    <dataInput id="Task_Input_input_topic" name="topic" />
    <dataInput id="Task_Input_input_interactionType" name="interactionType" />
    <dataInput id="Task_Input_input_freeText" name="freeText" />
    <dataOutput id="Task_Input_output_answer" name="answer" />
    <inputSet id="Task_Input_input_set">
    <dataInputRefs>Task_Input_input_topic</dataInputRefs>
    <dataInputRefs>Task_Input_input_interactionType</dataInputRefs>
    <dataInputRefs>Task_Input_input_freeText</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Input_output_set">
    <dataOutputRefs>Task_Input_output_answer</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>topic</sourceRef>
    <targetRef>Task_Input_input_topic</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>input</from><to>Task_Input_input_interactionType</to></assignment>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>{"name":"freeformAnswer","placeholder":"Write a short answer"}</from><to>Task_Input_input_freeText</to></assignment>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Input_output_answer</sourceRef>
    <targetRef>freeformAnswer</targetRef>
  </dataOutputAssociation>
</userTask>

    <userTask id="Task_Confirm" name="Confirm continuation">
  <documentation>Continue with the proposed workflow?</documentation>
  <ioSpecification>
    <dataInput id="Task_Confirm_input_interactionType" name="interactionType" />
    <dataOutput id="Task_Confirm_output_answer" name="answer" />
    <inputSet id="Task_Confirm_input_set">
    <dataInputRefs>Task_Confirm_input_interactionType</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Confirm_output_set">
    <dataOutputRefs>Task_Confirm_output_answer</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <assignment><from>confirm</from><to>Task_Confirm_input_interactionType</to></assignment>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Confirm_output_answer</sourceRef>
    <targetRef>approved</targetRef>
  </dataOutputAssociation>
</userTask>

    <userTask id="Task_Choice" name="Static choice">
  <documentation>Which direction should the workflow emphasize?</documentation>
  <ioSpecification>
    <dataInput id="Task_Choice_input_interactionType" name="interactionType" />
    <dataInput id="Task_Choice_input_choices" name="choices" />
    <dataOutput id="Task_Choice_output_answer" name="answer" />
    <inputSet id="Task_Choice_input_set">
    <dataInputRefs>Task_Choice_input_interactionType</dataInputRefs>
    <dataInputRefs>Task_Choice_input_choices</dataInputRefs>
  </inputSet>
    <outputSet id="Task_Choice_output_set">
    <dataOutputRefs>Task_Choice_output_answer</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <assignment><from>choice</from><to>Task_Choice_input_interactionType</to></assignment>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>[{"value":"expand","label":"Explore more","description":"Gather broader context before narrowing."},{"value":"narrow","label":"Narrow scope","description":"Pick the smallest useful slice now."}]</from><to>Task_Choice_input_choices</to></assignment>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_Choice_output_answer</sourceRef>
    <targetRef>selectedDirection</targetRef>
  </dataOutputAssociation>
</userTask>

    <userTask id="Task_ChoiceInput" name="Choice with custom answer">
  <documentation>How should qianji repair this workflow?</documentation>
  <ioSpecification>
    <dataInput id="Task_ChoiceInput_input_interactionType" name="interactionType" />
    <dataInput id="Task_ChoiceInput_input_choices" name="choices" />
    <dataInput id="Task_ChoiceInput_input_freeText" name="freeText" />
    <dataOutput id="Task_ChoiceInput_output_answer" name="answer" />
    <inputSet id="Task_ChoiceInput_input_set">
    <dataInputRefs>Task_ChoiceInput_input_interactionType</dataInputRefs>
    <dataInputRefs>Task_ChoiceInput_input_choices</dataInputRefs>
    <dataInputRefs>Task_ChoiceInput_input_freeText</dataInputRefs>
  </inputSet>
    <outputSet id="Task_ChoiceInput_output_set">
    <dataOutputRefs>Task_ChoiceInput_output_answer</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <assignment><from>choice_input</from><to>Task_ChoiceInput_input_interactionType</to></assignment>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>[{"value":"minimal","label":"Minimal fix","description":"Only repair the failing contract."},{"value":"broaden","label":"Broaden coverage","description":"Add schema tests around the failure."}]</from><to>Task_ChoiceInput_input_choices</to></assignment>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>{"name":"choiceInputAnswer","placeholder":"Type a custom repair direction","optional":true}</from><to>Task_ChoiceInput_input_freeText</to></assignment>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_ChoiceInput_output_answer</sourceRef>
    <targetRef>choiceInputAnswer</targetRef>
  </dataOutputAssociation>
</userTask>

    <userTask id="Task_DynamicChoiceInput" name="Dynamic generated question">
  <documentation>Ask the generated question with generated options.</documentation>
  <ioSpecification>
    <dataInput id="Task_DynamicChoiceInput_input_currentQuestion" name="currentQuestion" />
    <dataInput id="Task_DynamicChoiceInput_input_currentChoices" name="currentChoices" />
    <dataInput id="Task_DynamicChoiceInput_input_interactionType" name="interactionType" />
    <dataInput id="Task_DynamicChoiceInput_input_question" name="question" />
    <dataInput id="Task_DynamicChoiceInput_input_choices" name="choices" />
    <dataInput id="Task_DynamicChoiceInput_input_freeText" name="freeText" />
    <dataOutput id="Task_DynamicChoiceInput_output_answer" name="answer" />
    <inputSet id="Task_DynamicChoiceInput_input_set">
    <dataInputRefs>Task_DynamicChoiceInput_input_currentQuestion</dataInputRefs>
    <dataInputRefs>Task_DynamicChoiceInput_input_currentChoices</dataInputRefs>
    <dataInputRefs>Task_DynamicChoiceInput_input_interactionType</dataInputRefs>
    <dataInputRefs>Task_DynamicChoiceInput_input_question</dataInputRefs>
    <dataInputRefs>Task_DynamicChoiceInput_input_choices</dataInputRefs>
    <dataInputRefs>Task_DynamicChoiceInput_input_freeText</dataInputRefs>
  </inputSet>
    <outputSet id="Task_DynamicChoiceInput_output_set">
    <dataOutputRefs>Task_DynamicChoiceInput_output_answer</dataOutputRefs>
  </outputSet>
  </ioSpecification>
  <dataInputAssociation>
    <sourceRef>currentQuestion</sourceRef>
    <targetRef>Task_DynamicChoiceInput_input_currentQuestion</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>currentChoices</sourceRef>
    <targetRef>Task_DynamicChoiceInput_input_currentChoices</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>choice_input</from><to>Task_DynamicChoiceInput_input_interactionType</to></assignment>
  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>currentQuestion</sourceRef>
    <targetRef>Task_DynamicChoiceInput_input_question</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>currentChoices</sourceRef>
    <targetRef>Task_DynamicChoiceInput_input_choices</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <assignment><from>{"name":"dynamicAnswer","placeholder":"Type another answer","optional":true}</from><to>Task_DynamicChoiceInput_input_freeText</to></assignment>
  </dataInputAssociation>
  <dataOutputAssociation>
    <sourceRef>Task_DynamicChoiceInput_output_answer</sourceRef>
    <targetRef>dynamicAnswer</targetRef>
  </dataOutputAssociation>
</userTask>

    <endEvent id="End"/>

    <sequenceFlow id="Flow_Start_Input" sourceRef="Start" targetRef="Task_Input"/>
    <sequenceFlow id="Flow_Input_Confirm" sourceRef="Task_Input" targetRef="Task_Confirm"/>
    <sequenceFlow id="Flow_Confirm_Choice" sourceRef="Task_Confirm" targetRef="Task_Choice"/>
    <sequenceFlow id="Flow_Choice_ChoiceInput" sourceRef="Task_Choice" targetRef="Task_ChoiceInput"/>
    <sequenceFlow id="Flow_ChoiceInput_Dynamic" sourceRef="Task_ChoiceInput" targetRef="Task_DynamicChoiceInput"/>
    <sequenceFlow id="Flow_Dynamic_End" sourceRef="Task_DynamicChoiceInput" targetRef="End"/>
  </process>
</definitions>
