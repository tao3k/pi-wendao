{
  "name": "pi-wendao",
  "version": "0.1.0",
  "bin": {
    "pi-wendao": "./dist/cli/pi-wendao.js"
  },
  "type": "module",
  "exports": {
    "./arrow/ipc": {
      "types": "./dist/arrow/ipc.d.ts",
      "import": "./dist/arrow/ipc.js"
    },
    "./arrow/schema": {
      "types": "./dist/arrow/schema.d.ts",
      "import": "./dist/arrow/schema.js"
    },
    "./subagents": {
      "types": "./dist/subagents.d.ts",
      "import": "./dist/subagents.js"
    },
    "./subagents/activity": {
      "types": "./dist/subagents/activity.d.ts",
      "import": "./dist/subagents/activity.js"
    },
    "./qianji-server": {
      "types": "./dist/qianji-server.d.ts",
      "import": "./dist/qianji-server.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./wendao-server": {
      "types": "./dist/wendao-server.d.ts",
      "import": "./dist/wendao-server.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && npm run build:types && npm run build:js && chmod +x dist/cli/pi-wendao.js",
    "build:js": "rspack build",
    "build:types": "tsc --emitDeclarationOnly",
    "check": "tsc --noEmit && vitest run test/project-harness.test.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "harness": "typescript-project-harness .",
    "harness:agent-compact": "typescript-project-harness --agent-compact .",
    "harness:agent": "typescript-project-harness --agent-snapshot .",
    "lint": "oxlint .",
    "prepack": "npm run build",
    "test": "vitest run --exclude test/project-harness.test.ts && vitest run test/project-harness.test.ts",
    "test:search-live": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; RUN_PI_WENDAO_SEARCH_STRATEGY_FLOW_LIVE=1 vitest run test/cli/pi-wendao-cli.test.ts -t \"live SearchStrategyFlow\"'",
    "test:search-bridge-smoke": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; RUN_PI_WENDAO_SEARCH_STRATEGY_FLOW_BRIDGE_SMOKE=1 vitest run test/cli/pi-wendao-cli.test.ts -t \"Rust bridge SearchStrategyFlow smoke\"'",
    "test:workflow-subagent-bpmn-live": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; RUN_PI_WENDAO_WORKFLOW_SUBAGENT_BPMN_LIVE=1 vitest run test/cli/workflow-runner-subagents-bpmn.test.ts -t \"live native subagent model\"'",
    "test:workflow-subagent-bpmn-server-smoke": "sh -c 'RUN_PI_WENDAO_QIANJI_WORKFLOW_SERVER_SMOKE=1 PI_WENDAO_QIANJI_WORKFLOW_SERVER_URL=${PI_WENDAO_QIANJI_WORKFLOW_SERVER_URL:-http://127.0.0.1:38130} vitest run test/cli/workflow-runner-subagents-server-smoke.test.ts'",
    "test:flowhub-gateway-smoke": "RUN_PI_WENDAO_FLOWHUB_GATEWAY_SMOKE=1 vitest run test/cli/flowhub-gateway-smoke.test.ts",
    "test:search-precision": "jiti src/cli/search/strategy-flow-precision-gate.ts",
    "benchmark:search-markdown-corpus": "jiti src/cli/search/strategy-flow-markdown-corpus-benchmark.ts",
    "benchmark:search-markdown-corpus-live": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; jiti src/cli/search/strategy-flow-markdown-corpus-benchmark.ts --live \"$@\"' --",
    "benchmark:workflow-subagent-bpmn": "jiti src/cli/workflow-subagent-benchmark.ts",
    "benchmark:workflow-subagent-bpmn-live": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; jiti src/cli/workflow-subagent-benchmark.ts --live \"$@\"' --",
    "pi-wendao": "node dist/cli/pi-wendao.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@eko24ive/pi-ask": "^1.0.1",
    "@mariozechner/jiti": "^2.6.5",
    "@twogiants/pi-anthropic-vertex": "^0.1.8",
    "@types/dagre": "^0.7.54",
    "apache-arrow": "^21.1.0",
    "commander": "^13.0.0",
    "dagre": "^0.8.5",
    "effect": "^3.21.2",
    "fast-xml-parser": "^5.7.1",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@rspack/cli": "^2.0.4",
    "@rspack/core": "^2.0.4",
    "typescript": "^5.8.0",
    "typescript-lang-project-harness": "github:tao3k/typescript-lang-project-harness#4498e8f",
    "vitest": "^3.2.6"
  },
  "typescriptProjectHarness": {
    "extensions": {
      "effect": "enable"
    }
  }
}
